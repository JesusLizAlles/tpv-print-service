{
  "name": "tpv-print-service",
  "productName": "TPV Print Service",
  "version": "0.3.0",
  "description": "Agente de impresión para el TPV de SET Hotels: servicio de Windows que imprime tickets y comandas en impresoras ESC/POS",
  "private": true,
  "type": "module",
  "author": "Jesús Liz Alles",
  "license": "MIT",
  "homepage": "https://github.com/JesusLizAlles/tpv-print-service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesusLizAlles/tpv-print-service.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node dist/app/agent.cjs run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "node scripts/build.mjs && node scripts/fetch-win-deps.mjs && node scripts/make-installer.mjs"
  },
  "dependencies": {
    "iconv-lite": "0.7.3",
    "jpeg-js": "0.4.4",
    "koffi": "3.3.5",
    "node-forge": "1.4.2",
    "pngjs": "7.0.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/node-forge": "1.3.14",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "typescript": "5.9",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "koffi": false,
    "esbuild": true
  }
}
